#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    ofstream outFile("color.txt");

    if (!outFile) {
        cout << "Error creating file color.txt" << endl;
        return 1;
    }

    outFile << "Red" << endl;
    outFile << "Blue" << endl;
    outFile << "Green" << endl;
    outFile << "Yellow" << endl;
    outFile << "Purple" << endl;

    outFile.close();

    ifstream inFile("color.txt");

    if (!inFile) {
        cout << "Error opening file color.txt for reading" << endl;
        return 1;
    }

    ofstream copyFile("color_copy.txt");

    // Check if copy file opened successfully
    if (!copyFile) {
        cout << "Error creating file color_copy.txt" << endl;
        inFile.close();
        return 1;
    }

    string line;

    // Read from original file and write to copy file
    while (getline(inFile, line)) {
        copyFile << line << endl;
    }

    // Close both files
    inFile.close();
    copyFile.close();

    cout << "File copied successfully!" << endl;

    return 0;
}
